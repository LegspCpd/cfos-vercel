# dependencies
node_modules
.pnp
.pnp.*

# next.js
.next/
out/
build/

# production
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — DO NOT commit secrets
.env
.env*.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# NOTE: some teams commit the generated client; we generate on install instead.
prisma/dev.db

# build-time generated site icons (see scripts/fetch-favicon.mjs)
# NOTE: site-icon.png / apple-touch-icon.png are pure build outputs. The PWA icons
# (app-icon.png, icon-192.png, icon-512.png) stay TRACKED in git as the fallback set
# used when SITE_IMG_URL is not set; when SITE_IMG_URL IS set, fetch-favicon.mjs
# overwrites them at build time with the site's own image (also PNG).
public/site-icon.png
public/apple-touch-icon.png

# build-time vendored Waline assets (see scripts/fetch-waline.mjs)
public/vendor/

# generated secondary Prisma client (see schema-secondary.prisma; built on install)
src/generated/
