# ============================================================
# 数据库连接串（Vercel Postgres / Neon / 本地 Postgres）
# 本地开发示例：
#   postgresql://postgres:postgres@localhost:5432/cfos
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cfos"

# ============================================================
# 会话加密密钥（生产环境务必改成随机长字符串）
# 生成方式: openssl rand -base64 32
# ============================================================
AUTH_SECRET="change-me-to-a-random-64-char-secret"

# ============================================================
# LLM API Key（二选一即可，agent 会按需使用）
# 推荐用 DeepSeek（便宜）：
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   DEFAULT_MODEL=deepseek-chat
# 或 OpenAI：
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# 默认使用的模型名，例如 gpt-4o / deepseek-chat
DEFAULT_MODEL="gpt-4o-mini"
# ============================================================

# 指定管理员用户名（可选；多个用英文逗号分隔，如 "admin,ops"）。
# 不配则第一个注册的用户自动成为管理员。也可以在管理后台动态管理 AI providers。
ADMIN_USERNAME=""

# ============================================================
# GitHub OAuth 登录（可选）
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL: https://os.example.com
#   Authorization callback URL: https://os.example.com/api/auth/github/callback
# ============================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 站点公开地址（影响 GitHub OAuth 回调地址，必填，不能用 localhost）
PUBLIC_SITE_URL="https://os.example.com"

# ============================================================
# Cloudflare R2 文件分享存储（可选，配了才启用文件分享）
# 在 Cloudflare 控制台 → R2 → 创建存储桶 → 管理 R2 API 令牌：
#   1. R2 → Create bucket（记录桶名）
#   2. 右上角 Manage R2 API Tokens → Create API token（选 "Object Read & Write"）
#   3. 拿到 Access Key ID / Secret Access Key
#   4. Account ID：Cloudflare 仪表盘右侧栏可复制
# ============================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Cron 清理密钥（保护 /api/cron/cleanup，可选但推荐）
CRON_SECRET="change-me"

# ============================================================
# Cloudflare Access（完整版 SSO 网关，可选）
# 前提：你的域名 os.example.com 走 Cloudflare 代理（orange cloud）。
# 配置步骤：
#   1. Cloudflare 控制台 → Zero Trust → Access → Applications → 新建应用
#      - 应用域名：os.example.com（或你实际的 Vercel 域名）
#      - 策略里选登录方式（如 GitHub/Google/邮箱）
#   2. 记下应用的 AUD Tag（在应用详情页的 Overview 里）
#   3. CF_ACCESS_TEAM = 你的 Cloudflare Zero Trust 团队名（Access 域名形如 xxx.cloudflareaccess.com）
#   4. CF_ACCESS_AUD = 上面记下的 AUD Tag
# 启用后：用户必须通过 Cloudflare Access 认证才能访问，后端 API 会校验 CF 注入的 JWT。
# ============================================================
CF_ACCESS_TEAM=""
CF_ACCESS_AUD=""

# 站点公开地址（影响绝对链接，非必填）
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 全站背景图 URL（可选；客户端可读，需 NEXT_PUBLIC_ 前缀；每次刷新重新请求）
# NEXT_PUBLIC_BEIJIN="https://example.com/bg.jpg"
# 自定义网站图标/Logo（可选）：SITE_IMG_URL 用于服务端 favicon；
# 客户端 Logo 需用 NEXT_PUBLIC_SITE_IMG_URL（推荐两者配同一个值）。
# 构建时会自动下载 SITE_IMG_URL 的图片并转成 PNG 作为网站图标（即使原图是 JPG）。
# NEXT_PUBLIC_SITE_IMG_URL="https://example.com/logo.png"
# SITE_IMG_URL="https://example.com/logo.png"
# Waline 评论服务地址（可选；启用评论时用）
# NEXT_PUBLIC_COMMENTS_SERVER_URL="https://chat.example.com"
# Waline 前端资源 CDN（可选；默认 unpkg 官方源，自托管或镜像时用）
# NEXT_PUBLIC_WALINE_CSS="https://unpkg.com/@waline/client@v3/dist/waline.css"
# NEXT_PUBLIC_WALINE_JS="https://unpkg.com/@waline/client@v3/dist/waline.js"
# 邮箱验证码有效期（分钟，可选；默认 10）
# VERIFY_CODE_TTL_MINUTES="10"

# ============================================================
# 部署服务（Cloudflare Pages + 短链）—— 可选，配了才启用「部署」按钮
# 1) Cloudflare Pages 部署
#    PAGES_KEY：Cloudflare API Token，需有 Cloudflare Pages 编辑/部署 权限。
#    PAGES_ACCOUNT_ID：Cloudflare 账户 ID（控制台首页右下角可复制）。
# 2) 短链服务（sink.cool / s.legspcpd.top）
#    S_LINK：sink.cool 的站点 token（Authorization: Bearer <S_LINK>）。
#    S_LINK_BASE：短链系统基址，默认 https://sink.cool。
# ============================================================
PAGES_KEY=""
PAGES_ACCOUNT_ID=""
S_LINK=""
# S_LINK_BASE="https://sink.cool"

# ============================================================
# Cloudflare KV 响应缓存（可选，配了能显著加快 Pages 列表/仓库加载）
# 支持最多 5 个 KV 库，按地区分布（读取就近路由，写入多地区冗余）。
# 地区代码：ASIA（亚洲）/ NA（北美）/ SA（南美）/ EU（欧洲），
# 同一地区有两个库就在后面加 -2（如 KV_ASIA_2_*）。
#   1. Cloudflare 控制台 → Workers & Pages → KV → Create namespace（记录 Namespace ID）
#   2. KV_<地区>_API_TOKEN：API token 需有该 namespace 的 Workers KV → Edit 权限
#      （若 PAGES_KEY 已有 KV:Edit 权限，可直接复用 PAGES_KEY 的值）
#   3. KV_<地区>_ACCOUNT_ID 与 PAGES_ACCOUNT_ID 通常相同
# ============================================================
# KV_ASIA_ACCOUNT_ID=""
# KV_ASIA_API_TOKEN=""
# KV_ASIA_NAMESPACE_ID=""
# KV_ASIA_2_ACCOUNT_ID=""
# KV_ASIA_2_API_TOKEN=""
# KV_ASIA_2_NAMESPACE_ID=""
# KV_NA_ACCOUNT_ID=""
# KV_NA_API_TOKEN=""
# KV_NA_NAMESPACE_ID=""
# KV_SA_ACCOUNT_ID=""
# KV_SA_API_TOKEN=""
# KV_SA_NAMESPACE_ID=""
# KV_EU_ACCOUNT_ID=""
# KV_EU_API_TOKEN=""
# KV_EU_NAMESPACE_ID=""
# KV_PREFIX="cfos"
# KV_DEFAULT_TTL="60"
