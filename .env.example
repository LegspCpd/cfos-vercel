# ============================================================
# 数据库连接串（Vercel Postgres / Neon / 本地 Postgres）
# 本地开发示例：
#   postgresql://postgres:postgres@localhost:5432/cfos
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cfos"

# ============================================================
# 会话加密密钥（生产环境务必改成随机长字符串）
# 生成方式: openssl rand -base64 32
# ============================================================
AUTH_SECRET="change-me-to-a-random-64-char-secret"

# ============================================================
# LLM API Key（二选一即可，agent 会按需使用）
# 推荐用 DeepSeek（便宜）：
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   DEFAULT_MODEL=deepseek-chat
# 或 OpenAI：
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# 默认使用的模型名，例如 gpt-4o / deepseek-chat
DEFAULT_MODEL="gpt-4o-mini"
# ============================================================

# 指定管理员用户名（可选；多个用英文逗号分隔，如 "LegspCpd,admin"）。
# 不配则第一个注册的用户自动成为管理员。也可以在管理后台动态管理 AI providers。
ADMIN_USERNAME=""

# ============================================================
# GitHub OAuth 登录（可选）
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL: https://os.legspcpd.top
#   Authorization callback URL: https://os.legspcpd.top/api/auth/github/callback
# ============================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 站点公开地址（影响 GitHub OAuth 回调地址，必填，不能用 localhost）
PUBLIC_SITE_URL="https://os.legspcpd.top"

# 站点公开地址（影响绝对链接，非必填）
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
