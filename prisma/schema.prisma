// Prisma schema for the Vercel rewrite of Cloudflare OS.
// Postgres replaces Cloudflare Durable Object SQLite as the data layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single application user. Replaces UserDurableObject.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String // argon2id hash, computed server-side
  // Google OAuth subject id (if the account was created / linked via Google login).
  googleId     String?  @unique
  // GitHub numeric user id (if the account was linked via GitHub login/connect).
  githubId     Int?     @unique
  // Microsoft (Entra ID) object id (if the account was created / linked via Microsoft login).
  microsoftId  String?  @unique
  // Verified email (used for email-code signup). Optional.
  email        String?  @unique
  // Custom avatar image URL (uploaded via the admin-provided image host).
  avatarUrl    String?
  // Whether the user has finished the required "complete your profile" step after a
  // third-party (OAuth) sign-up. New OAuth accounts start false and must set a username
  // + password (+ human verification) before using the app.
  profileComplete Boolean @default(true)
  isAdmin      Boolean  @default(false)
  // User group. A group defines the set of feature permissions the user has
  // (permissions fully decide what a user can do — see src/lib/permissions.ts).
  groupId      String?
  createdAt    DateTime @default(now())
  // Account-deletion (self-serve) request. When deleteAt is set, the account is on a
  // 4–7 day cooldown; the user can cancel until the deadline passes, after which the
  // account and all its data are permanently deleted (the email/username free up).
  deleteRequestedAt DateTime?
  deleteAt           DateTime?
  // For accounts WITHOUT a bound email: set when the user re-authenticates via OAuth to
  // confirm account deletion (valid for a short window). Null for accounts that delete
  // via email code.
  deleteOauthVerifiedAt DateTime?

  workspaces Workspace[]
  chats      Chat[]
  sharedFiles SharedFile[]
  githubConnection GitHubConnection?
  googleConnection GoogleConnection?
  gitlabConnection GitlabConnection?
  contextDocs ContextDoc[]
  favorites  Favorite[]
  tickets    Ticket[]
  group UserGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

// A user group with a set of feature permissions. A user moved into a group inherits
// that group's permissions (permissions fully decide capability).
model UserGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  // JSON array of permission codes, e.g. ["workspace.create","admin.access"].
  permissions String   @default("[]")
  // Marked as an "admin" group (管理类): members can see management/admin features.
  isAdminGroup Boolean @default(false)
  createdAt   DateTime @default(now())

  users User[]
}

// An email verification code issued during email-based signup (or email change).
// One row per pending email; codes expire after a short window.
// NOTE: this deliberately has NO relation to User — a code is issued BEFORE the user
// record exists (during signup), so a FK on User.email would fail the insert.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String // 6-8 digit code (stored hashed for safety)
  expiresAt DateTime // e.g. now + 10 minutes
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// A support ticket submitted by a user: feedback, email-change appeals, or general
// requests. Admins review and handle them from the admin Tickets panel.
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  // "feedback" | "emailChange" | "appeal" | "other"
  type      String
  title     String
  content   String
  // Submitter's IP address, captured at submission time.
  ip        String?
  // "open" | "processing" | "closed"
  status    String   @default("open")
  handledBy String? // admin userId who last handled it
  reply     String? // admin reply text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

// A single-row settings table (key = "singleton"). Holds deployment-level switches
// that an admin can flip at runtime without redeploying.
model AppSetting {
  key   String @id
  value String
}

// An AI provider (LLM endpoint) that the agent can use. Multiple providers can be
// configured at runtime via the admin/providers UI, each with its own API key.
model AiProvider {
  id        String   @id @default(cuid())
  name      String   // display name, e.g. "DeepSeek", "OpenAI", "Local"
  baseUrl   String   // OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1
  apiKey    String   // the API token
  model     String   // default model for this provider, e.g. deepseek-chat
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([name])
}

// A workspace ("gadget" in Cloudflare OS terms) owned by a user.
// Holds a collection of files (the app's source code).
model Workspace {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  // Public share token (uuid). When set, the workspace is viewable read-only by anyone
  // at /blueprint/[shareToken] without logging in (mirrors the original OS's public blueprints).
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files WorkspaceFile[]
  chats Chat[]
  favorites Favorite[]
}

// A user's favorite (starred) workspace, mirroring the original OS's "favorites" rail.
model Favorite {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// One file inside a workspace.
model WorkspaceFile {
  id          String @id @default(cuid())
  workspaceId String
  path        String // e.g. "index.html", "src/App.tsx"
  content     String @default("")
  isEntry     Boolean @default(false) // the file previewed / run first

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions WorkspaceFileVersion[]

  @@unique([workspaceId, path])
}

// A historical snapshot of a workspace file, captured whenever its content changes.
// Enables "undo / restore earlier version" like the original OS's per-file history.
model WorkspaceFileVersion {
  id        String   @id @default(cuid())
  fileId    String
  content   String   @default("")
  createdAt DateTime @default(now())

  file WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

// A chat conversation attached to a workspace (or standalone).
model Chat {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  title       String   @default("New chat")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String // "user" | "assistant" | "tool"
  content   String   @default("")
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// A file uploaded to Cloudflare R2 and shared via a link, with an expiry.
model SharedFile {
  id           String   @id @default(cuid())
  ownerId      String // user who shared it
  workspaceId  String? // optional source workspace
  r2Key        String   @unique // object key in the R2 bucket
  fileName     String // original name, used as download name
  mimeType     String   @default("application/octet-stream")
  sizeBytes    Int
  expiresAt    DateTime // link stops working after this
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
}

// A user's OAuth connection to GitHub. Lets the agent call the GitHub API on the user's behalf.
model GitHubConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  githubLogin String
  accessToken String // stored; used by the agent's GitHub tools
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("GitHubConnection")
}

// A user's OAuth connection to Google. Lets the agent call Google APIs on the user's behalf.
model GoogleConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  googleEmail String
  accessToken String // stored; used by the agent's Google tools
  refreshToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("GoogleConnection")
}

// A user's OAuth connection to GitLab. Lets the agent call GitLab APIs on the user's behalf.
model GitlabConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  gitlabUsername String
  accessToken  String // stored; used by the agent's GitLab tools
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("GitlabConnection")
}

// A context document the user uploads for the agent to reference when building.
model ContextDoc {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  content   String // full text
  tags      String   @default("") // comma-separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// Audit trail of meaningful actions (auth, workspace ops, agent runs, AI calls).
// Provides the "operation audit / permission review" visibility the original system had.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // actor; null for anonymous/system events
  username  String? // denormalized for display convenience
  action    String // e.g. "auth.login", "workspace.create", "agent.run", "ai.call"
  targetId  String? // e.g. workspaceId, providerId
  detail    String? // human-readable summary / JSON payload
  // Client IP captured at write time (e.g. the user's login IP). Null when unknown.
  ip        String?
  // Token usage recorded on AI calls (total prompt+completion tokens), for analytics.
  tokens    Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
